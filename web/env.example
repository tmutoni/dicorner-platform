# Maximus Energy site — required secrets
# Copy to .env.local and fill in. Also add these in Vercel project settings.

# Resend (lead delivery)
RESEND_API_KEY=
MAXIMUS_TO_EMAIL=
# Optional: verified sender address on your Resend domain. Defaults to the
# Resend sandbox sender, which only delivers to the account owner.
MAXIMUS_FROM_EMAIL="Maximus Energy <hello@yourdomain.com>"

# Google Maps Static API (case-story thumbnails).
# Exposed to the client — restrict the key by HTTP referrer in GCP.
NEXT_PUBLIC_GOOGLE_MAPS_STATIC_API_KEY=
